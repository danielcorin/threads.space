# Copy to .env and fill in the five values from the README's setup steps.
#
# Local development: `npm run db:seed:local` (in ../../api) seeds a stable bot-test
# fixture with these exact values, so you can paste them in and test repeatedly:
#   THREADS_API_URL=http://localhost:8788
#   THREADS_BOT_TOKEN=seed-echobot-token-local-dev
#   THREADS_BOT_USER_ID=seed-echobot-user
#   THREADS_BOT_USERNAME=echobot
#   THREADS_CHANNEL_ID=seed-bot-test-channel

# Base URL of the Threads API (no trailing slash).
#   local dev:   http://localhost:8788
#   production:  https://threads.example.com/api
THREADS_API_URL=http://localhost:8788

# Bot bearer token, from POST /users/:id/api-tokens (shown once).
THREADS_BOT_TOKEN=

# The bot's own user id and username (from POST /users).
# The bot uses these to ignore its own messages and detect @mentions.
THREADS_BOT_USER_ID=
THREADS_BOT_USERNAME=echobot

# OPTIONAL. The bot auto-discovers every channel and DM it belongs to (GET /channels +
# GET /dms) and re-checks periodically, so it normally needs no channel id at all. Set
# this to *also* pin a specific channel (e.g. the seed channel), or use the plural
# THREADS_CHANNEL_IDS for a comma-separated list.
THREADS_CHANNEL_ID=
# THREADS_CHANNEL_IDS=chan-a,chan-b

# OPTIONAL. Process cancellation always works over the channel WebSocket. Set a port to
# ALSO accept it over webhooks (the second transport): expose this port to Threads (a
# tunnel in local dev), register the URL via POST /users/me/webhooks, and put that
# webhook's signing secret here to verify signatures (omit the secret to skip
# verification in local dev).
# THREADS_WEBHOOK_PORT=8799
# THREADS_WEBHOOK_SECRET=
